{
    // "image": "takumi.city/jax-cpu-training",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.autopep8",
                "GitHub.copilot-chat",
                "GitHub.copilot",
                "ms-python.python",
                "ms-toolsai.jupyter",
                "BazelBuild.vscode-bazel",
                "llvm-vs-code-extensions.vscode-clangd",
                "moonshot-ai.kimi-code",
                "pbkit.vscode-pbkit",
                "Tyriar.sort-lines",
                "anthropic.claude-code"
            ]
        }
    },
    "runArgs": [
        "--network=host"
    ],
    "workspaceMount": "source=/large_nfs/game-mcts,target=/large_nfs/game-mcts,type=bind",
    "mounts": [
        "source=${localEnv:HOME}/.cache,target=/home/ubuntu/.cache,type=bind",
        // Share the host's Claude Code credentials + settings with the container.
        "source=${localEnv:HOME}/.claude,target=/home/ubuntu/.claude,type=bind"
    ],
    "containerEnv": {
        // Keep .claude.json (project state) inside the mounted dir too, so no
        // single-file bind mount is needed and atomic rewrites still work.
        "CLAUDE_CONFIG_DIR": "/home/ubuntu/.claude"
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest",
            "enableNonRootDocker": "true",
            "moby": "true"
        }
    },
    "workspaceFolder": "/large_nfs/game-mcts"
}