# MODULE.bazel

module(
    name = "game_mcts",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "pybind11_bazel", version = "3.0.0")
bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "google_benchmark", version = "1.9.2")
bazel_dep(name = "abseil-cpp", version = "20250814.1")
bazel_dep(name = "protobuf", version = "32.1")
bazel_dep(name = "boost.math", version = "1.89.0.bcr.2")
bazel_dep(name = "boost.multiprecision", version = "1.89.0.bcr.2")
bazel_dep(name = "boost.random", version = "1.89.0.bcr.2")
bazel_dep(name = "boost.iterator", version = "1.89.0.bcr.2")
bazel_dep(name = "grpc", version = "1.74.1")

# The arena: the problem-running framework the tournament server became. It
# depends on nothing here -- this repo supplies its games through a registry
# linked at build time (see //game_mcts/arena).
#
# Pinned rather than pointed at a sibling checkout so a build needs nothing but
# this repo. It also suits the sandbox fleet: candidates are built in a
# container with no egress, so the image has to carry a warm bazel repository
# cache either way, and a pinned commit is one more entry in it -- whereas a
# path override would have to be bind-mounted into every container.
#
# Bump this when the arena changes; the two repos are versioned independently
# on purpose.
bazel_dep(name = "game_arena", version = "0.1.0")
git_override(
    module_name = "game_arena",
    remote = "https://github.com/geligeli/game-arena.git",
    commit = "a5b5e28e84f8849ad55ad32c9af0c3ddbc8c6548",
)

# For co-developing the two repos, swap the override above for this one. It
# needs the sibling checkout visible to bazel, which inside the devcontainer
# means widening workspaceMount in .devcontainer/devcontainer.json to
# /large_nfs -- the default mount is this repo only.
# local_path_override(
#     module_name = "game_arena",
#     path = "/large_nfs/game-arena",
# )

# Workaround for https://github.com/protocolbuffers/protobuf/issues/22386:
# @protobuf//python/dist loads @protobuf_pip_deps//:requirements.bzl, but that
# repo is only created by a dev_dependency extension, so it is missing when
# protobuf is not the root module. The patch drops the load (only used for
# building protobuf's own wheels, which we don't do).
single_version_override(
    module_name = "protobuf",
    patches = [
        "//:protobuf_python_dist_build.patch",
        "//:protobuf_python_dist_bzl.patch",
    ],
    patch_strip = 1,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")

# Runtime deps for the MCP servers (mcp_servers/requirements.txt).
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "mcp_pip_deps",
    python_version = "3.12",
    requirements_lock = "//mcp_servers:requirements.txt",
)
use_repo(pip, "mcp_pip_deps")

