# MODULE.bazel

module(
    name = "game_mcts",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_cc", version = "0.2.25")

# The C++ toolchain is hermetic-llvm (clang + libc++ + compiler-rt, no sysroot),
# and it is @game_arena that registers it, so that this repo, a kit and the
# sandbox image all compile with the same pinned compiler. Nothing is
# registered here; .bazelrc turns off bazel's host autodetection so the arena's
# registration is the only C++ toolchain there is, which is also what lets the
# build run on RBE workers that have no compiler installed. (A repo consuming
# game_mcts as a module brings its own: the arena is a dev_dependency here.)
#
# The dep is declared only so that `@llvm` resolves from this module: the
# sanitizer configs in .bazelrc set --@llvm//config:<san>. Keep the version in
# step with the arena's.
bazel_dep(name = "llvm", version = "0.8.21")

bazel_dep(name = "pybind11_bazel", version = "3.0.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.1")
bazel_dep(name = "google_benchmark", version = "1.9.2")
bazel_dep(name = "abseil-cpp", version = "20250814.1")
bazel_dep(name = "protobuf", version = "33.0")
bazel_dep(name = "boost.math", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.multiprecision", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.random", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.iterator", version = "1.90.0.bcr.1")

# The bots' Play-stream client (//bots:bot_deps) names it directly.
bazel_dep(name = "grpc", version = "1.74.1", dev_dependency = True)

# The arena: the problem-running framework risk2 is hosted on. It depends on
# nothing here -- //problem:registry supplies the rules and arena_problem in
# //:BUILD the tournament targets. Nothing under game_mcts/ may depend on it,
# which is what lets it be a dev_dependency: a repo consuming game_mcts as a
# module never resolves the arena (it is not on the BCR, and only a root module
# can override it). The kit and the sandbox build this repo as the root module.
#
# Pinned rather than pointed at a sibling checkout so a build needs nothing but
# this repo. It also suits the sandbox fleet: candidates are built in a
# container with no egress, so the image has to carry a warm bazel repository
# cache either way, and a pinned commit is one more entry in it -- whereas a
# path override would have to be bind-mounted into every container.
#
# Bump this when the arena changes; the two repos are versioned independently
# on purpose.
bazel_dep(name = "game_arena", version = "0.1.0", dev_dependency = True)
git_override(
    module_name = "game_arena",
    remote = "https://github.com/geligeli/game-arena.git",
    commit = "da59ee27e0ced0e6572514cef0e8d07f0def2435",
)

# The kit's base: the arena's image with coding agents (Claude Code, opencode,
# Antigravity) installed, which game-arena's quickstart.sh builds and pushes.
# Pinned by digest; bump it to what game-arena's examples/connect4 pins.
bazel_dep(name = "rules_oci", version = "2.3.0", dev_dependency = True)

oci = use_extension(
    "@rules_oci//oci:extensions.bzl",
    "oci",
    dev_dependency = True,
)
oci.pull(
    name = "kit_agents",
    digest = "sha256:27b351247b6a9688ef6f3ba410db4c52b7d2599921a66799c811d50d105c4d4e",
    image = "registry.takumi.city/game-arena-kit-agents",
)
use_repo(oci, "kit_agents")

# For co-developing the two repos, swap the override above for this one,
# pointing at your sibling checkout.
# local_path_override(
#     module_name = "game_arena",
#     path = "/fast/src/game-arena",
# )

# protobuf_bzlmod_fixes.patch is @game_arena's patch of the same name, copied:
# an override only acts in the root module, and its patches must live in the
# root module's tree, so it cannot be borrowed by label. Keep the two in step
# (and the protobuf version above with the arena's). It works around two bzlmod
# problems in protobuf 33.0, touching only machinery Bazel consumers cannot use
# anyway (building protobuf's own wheels, the unsupported fast-C++-protos
# extension):
#
# - https://github.com/protocolbuffers/protobuf/issues/22386:
#   @protobuf//python/dist loads @protobuf_pip_deps//:requirements.bzl, but
#   that repo is only created by a dev_dependency extension, so it is missing
#   when protobuf is not the root module.
# - https://github.com/protocolbuffers/protobuf/issues/24084: since 33.0
#   @system_python (and the wheel-only python header repos) come from a
#   dev_dependency extension too, but //python:protobuf_python -- the runtime
#   of every py_proto_library -- reaches them through select()s.
# - 33.0 also marks RepeatedPtrField(Arena*) deprecated while map_field.h
#   still uses it, which a -Werror build cannot include; wrapped in a
#   diagnostic pragma. Fixed upstream in 34.1.
single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//:protobuf_bzlmod_fixes.patch"],
)

# Dev-only: not in the BCR, and an archive_override acts only in the root module,
# so a consumer could not resolve it. Run through tools/cpp_format.sh, with
# cpp_format.yaml; keep the version in step with the arena's.
bazel_dep(name = "cpp_formatting", version = "0.1.0", dev_dependency = True)

CPP_FORMAT_VERSION = "20260926-f0228af"

archive_override(
    module_name = "cpp_formatting",
    urls = ["https://github.com/geligeli/cpp_formatting/archive/refs/tags/" + CPP_FORMAT_VERSION + ".tar.gz"],
    strip_prefix = "cpp_formatting-" + CPP_FORMAT_VERSION,
)

cpp_format = use_extension(
    "@cpp_formatting//bazel/integration:extensions.bzl",
    "cpp_format",
    dev_dependency = True,
)
cpp_format.release(version = CPP_FORMAT_VERSION)
use_repo(cpp_format, "cpp_format_bin")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")

# Dev-only: web/ compiles a candidate's policy to WebAssembly for the play page
# (wasm_cc_binary). Only web/'s manual targets reach it, so neither `//...`,
# a kit nor the sandbox image fetches emscripten.
bazel_dep(name = "emsdk", version = "6.0.9", dev_dependency = True)
