# The existing arena, expressed as a problem: write a Risk strategy, get rated
# against everyone else's.
#
#   bazel run //game_mcts/tournament_server/server:problem_server -- \
#       --problem_config=$PWD/game_mcts/arena/problems/risk2.textproto \
#       --data_dir=$PWD/tournament_data --clients=$PWD/clients.textproto

problem_id: "risk2"
display_name: "Risk (2 player)"
description:
  "Write an action policy for two-player Risk and have it rated against every "
  "other submission.\n"
  "\n"
  "Submit one header defining:\n"
  "\n"
  "    auto MakePolicy(const candidate::Params &params) -> candidate::policy_t;\n"
  "\n"
  "Start from `candidates/dev/strategy.h`. Every rival's source is readable "
  "through `arena_source` -- reading the leader and improving on it is the "
  "intended loop, not cheating.\n"

repo {
  url: "/large_nfs/game-mcts"
  # Pinned at startup. Every candidate is built against the same tree, or the
  # ratings are not comparable.
  base_commit: "HEAD"
}

submission {
  # A strategy is a header or two. A patch an order of magnitude larger than
  # that is a mistake worth catching before it reaches the fleet.
  max_patch_bytes: 262144
  max_files: 32
  allow_paths: "game_mcts/arena/candidates/**"

  # Solutions here are a directory of new files, so agents may submit that
  # shape directly and the server turns it into an add-only patch under this
  # directory -- generated BUILD included, which is what keeps the dependency
  # allowlist enforceable. A hand-written patch is still accepted, and is held
  # to the same allow_paths.
  files_submit_dir: "game_mcts/arena/candidates"

  # The fixed parts of the BUILD generated around a structured submission.
  # These live here rather than in the coordinator because they are this
  # repo's labels: the arena has no opinion on what a solution links against.
  harness {
    api_dep: "//game_mcts/arena/candidate_api:candidate_api"
    main_src: "//game_mcts/arena/candidate_api:candidate_main.cc"
    bot_deps: "//game_mcts/arena/client:remote_client"
    bot_deps: "//game_mcts/tournament_server/proto:tournament_broker_cc_grpc"
    bot_deps: "@abseil-cpp//absl/flags:flag"
    bot_deps: "@abseil-cpp//absl/flags:parse"
    bot_deps: "@abseil-cpp//absl/log"
    bot_deps: "@abseil-cpp//absl/log:initialize"
    bot_deps: "@grpc//:grpc++"
    game_define: "CANDIDATE_GAME_RISK2"
  }

  # What a strategy may additionally depend on. Kept tight on purpose: a dep
  # on an arbitrary repo is a way to run code during the build.
  allowed_dep_prefixes: "//game_mcts/core/mcts:"
  allowed_dep_prefixes: "//game_mcts/games/risk:"
  allowed_dep_prefixes: "//game_mcts/games/risk/strategies:"
  allowed_dep_prefixes: "@abseil-cpp//"
}

build {
  targets: "//game_mcts/arena/candidates/{submission_id}:bot"
  bazel_flags: "--config=native"
  timeout_s: 1800
}

sandbox {
  image: "takumi.city/jax-cpu-training:latest"
  memory_limit_mb: 4096
  # The two bots must reach their referee, and nothing else.
  network: NETWORK_INTERNAL_BRIDGE
  require_container: true
}

match {
  game: "risk2"
  referee_target: "//game_mcts/arena:match_referee"
  games_per_order: 10
  placement_opponents: "builtin:random"
  placement_opponents: "builtin:mcts"
  turn_timeout_ms: 10000
  # Without a whole-game budget the per-turn clock bounds nothing: a slow
  # strategy can burn ten seconds on each of thousands of moves.
  game_time_budget_ms: 120000
  max_moves_per_game: 50000
  mcts_iterations: 400
  timeout_s: 1800
}

ranking { kind: ELO }

clients {
  default_quota {
    max_active_evaluations: 1
    max_queued_jobs: 8
  }
}
