        "string_view": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp",
        "initializer_list": "cpp",
        "iosfwd": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "mutex": "cpp",
        "new": "cpp",
        "numbers": "cpp",
        "ostream": "cpp",
        "semaphore": "cpp",
        "stdexcept": "cpp",
        "stop_token": "cpp",
        "streambuf": "cpp",
        "thread": "cpp",
        "typeinfo": "cpp",
        "bitset": "cpp",
        "optional": "cpp",
        "cstring": "cpp",
        "unordered_set": "cpp",
        "sstream": "cpp",
        "fstream": "cpp",
        "set": "cpp"
    },
    "C_Cpp.errorSquiggles": "disabled",
    "python.autoComplete.extraPaths": [
        "/opt/flax",
        "/opt/jax",
        "/home/ubuntu/.local/lib/python3.12/site-packages",
        "/large_nfs/risk-game-ai",
    ],
    "python.defaultInterpreterPath": "/usr/bin/python",
    "interactiveWindow.alwaysScrollOnNewCell": false,
    "clangd.arguments": [
        "--compile-commands-dir=/large_nfs/risk-game-ai"
    ],
    "clangd.fallbackFlags": [
        "-I${workspaceFolder}",
        "-std=c++20"
    ],
    "clangd.enableHover": true,
    "files.exclude": {
        "bazel-risk-game-ai": true
    },
    "C_Cpp.clang_format_fallbackStyle": "Google",
    "clangd.onConfigChanged.forceEnable": true,
    "protobuf.clangFormat.enabled": true,
    "protobuf.clangFormat.path": "/usr/bin/clang-format",
    // "clangd.onConfigChangedForceEnable": true,
}